{
  "name": "sogio-api",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc && bun build ./src/index.ts --compile --outfile out",
    "typecheck": "tsc --noEmit",
    "dev": "bun --hot run src/index.ts",
    "start": "bun run ./src/index.ts",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:lint": "npm run lint && npm run format",
    "prepare": "husky",
    "test": "bun test --env-file=.env.test --preload ./tests/setup.ts",
    "db:push": "drizzle-kit push",
    "db:push:test": "bun --env-file=.env.test x drizzle-kit push",
    "db:migration": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "bun run scripts/seed_plans.ts",
    "db:baseline-migrations": "bun run scripts/baseline_drizzle_migrations.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/bun": "latest",
    "@types/jsonwebtoken": "^9.0.10",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "3.6.2",
    "tsx": "^4.22.4",
    "typescript-eslint": "^8.60.1"
  },
  "peerDependencies": {
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tuya/tuya-connector-nodejs": "^2.1.2",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.44.7",
    "jsonwebtoken": "^9.0.3",
    "node-ical": "^0.20.1",
    "pg": "^8.21.0",
    "resend": "^6.20.0",
    "zod": "^4.4.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
